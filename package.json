{
  "name": "legacy-app-rescue-site",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:site",
    "build:site": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "cargo test && npm run check && npm run build:site",
    "test": "playwright test",
    "test:all": "npm test",
    "test:performance": "sh scripts/verify-mobile-lcp.sh",
    "record:demo": "node scripts/record-demo.mjs",
    "check": "tsc --noEmit",
    "verify:billing": "node scripts/verify-billing.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:url": "sh scripts/verify-url.sh",
    "verify:package-managers": "node scripts/verify-package-managers.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
