{
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/robots.txt",
      "headers": {}
    },
    {
      "route": "/sitemap.xml",
      "headers": {}
    },
    {
      "route": "/favicon.svg",
      "headers": {}
    },
    {
      "route": "/apple-touch-icon.png",
      "headers": {}
    },
    {
      "route": "/404.css",
      "headers": {}
    },
    {
      "route": "/404.js",
      "headers": {}
    },
    {
      "route": "/install.sh",
      "headers": {}
    },
    {
      "route": "/install.ps1",
      "headers": {}
    },
    {
      "route": "/demo.cast",
      "headers": {}
    },
    {
      "route": "/demo",
      "rewrite": "/index.html"
    },
    {
      "route": "/privacy",
      "rewrite": "/index.html"
    },
    {
      "route": "/terms",
      "rewrite": "/index.html"
    },
    {
      "route": "/",
      "rewrite": "/index.html"
    },
    {
      "route": "/*",
      "statusCode": 404
    }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://api.github.com https://api.sociobot.in; object-src 'none'; base-uri 'self'; form-action 'self' https://api.sociobot.in; frame-ancestors 'none'"
  },
  "mimeTypes": {
    ".cast": "application/x-asciicast"
  }
}
